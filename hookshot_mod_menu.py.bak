        ).pack(anchor="w")
        tk.Label(
            info_card,
            text=(
                "Cuando entras a tu partida ('Continuar'), el Mod Menu busca automáticamente a Link en el Heap.\n"
                "Deja las casillas vacías para detección 100% automática (3 a 20 corazones), o escribe tus Corazones (ej. 18)\n"
                "y Flechas visibles en el arco (ej. 17) para filtrar al instante."
            ),
            bg=self.BG_CARD, fg=self.TEXT_MUTED, justify="left", font=("Segoe UI", 9)
        ).pack(anchor="w", pady=(4, 10))

        form = tk.Frame(info_card, bg=self.BG_CARD)
        form.pack(fill="x")

        tk.Label(form, text="Corazones Máx (vacío=Auto):", bg=self.BG_CARD, fg=self.TEXT_PRIMARY, font=("Segoe UI", 9, "bold")).pack(side="left")
        tk.Entry(form, textvariable=self.var_scan_hearts, width=6, bg=self.BG_MAIN, fg="#f43f5e", insertbackground="#fff", relief="flat", font=("Consolas", 10)).pack(side="left", padx=(6, 14), ipady=4)

        tk.Label(form, text="Flechas (ej. 17):", bg=self.BG_CARD, fg=self.TEXT_PRIMARY, font=("Segoe UI", 9, "bold")).pack(side="left")
        tk.Entry(form, textvariable=self.var_scan_arrows, width=6, bg=self.BG_MAIN, fg=self.ACCENT_GREEN, insertbackground="#fff", relief="flat", font=("Consolas", 10)).pack(side="left", padx=(6, 14), ipady=4)

        tk.Label(form, text="Rupias (opc.):", bg=self.BG_CARD, fg=self.TEXT_PRIMARY, font=("Segoe UI", 9, "bold")).pack(side="left")
        tk.Entry(form, textvariable=self.var_scan_rupees, width=7, bg=self.BG_MAIN, fg=self.ACCENT_CYAN, insertbackground="#fff", relief="flat", font=("Consolas", 10)).pack(side="left", padx=(6, 14), ipady=4)

        tk.Button(
            form, text="🔎 ESCANEAR HEAP AHORA", bg=self.ACCENT_GOLD, fg="#1e1b4b",
            font=("Segoe UI", 9, "bold"), bd=0, padx=14, pady=6, cursor="hand2",
            command=self._action_filtered_scan
        ).pack(side="left")

        addr_card = tk.Frame(parent, bg=self.BG_CARD, padx=16, pady=14, highlightthickness=1, highlightbackground=self.BORDER_COLOR)
        addr_card.pack(fill="x", pady=6)

        tk.Label(addr_card, text="📌  Dirección Activa de la Estructura de Link en Memoria", bg=self.BG_CARD, fg=self.TEXT_PRIMARY, font=("Segoe UI", 11, "bold")).pack(anchor="w")

        row_addr = tk.Frame(addr_card, bg=self.BG_CARD)
        row_addr.pack(fill="x", pady=(8, 4))
        tk.Label(row_addr, text="Base actual:", bg=self.BG_CARD, fg=self.TEXT_MUTED).pack(side="left")
        tk.Entry(row_addr, textvariable=self.var_custom_addr, width=22, bg=self.BG_MAIN, fg=self.ACCENT_GREEN, insertbackground="#fff", relief="flat", font=("Consolas", 11, "bold")).pack(side="left", padx=8, ipady=4)

        tk.Button(
            row_addr, text="Fijar Dirección Manual", bg=self.BG_CARD_ALT, fg=self.TEXT_PRIMARY,
            bd=0, padx=12, pady=5, cursor="hand2", command=self._action_set_manual_addr
        ).pack(side="left", padx=4)

        tk.Button(
            row_addr, text="Perfil 1 (0x107F37C000)", bg=self.BG_CARD_ALT, fg=self.ACCENT_CYAN,
            bd=0, padx=10, pady=5, cursor="hand2",
            command=lambda: self._set_preset_addr(0x107F37C000)
        ).pack(side="left", padx=4)

        tk.Button(
            row_addr, text="Perfil 2 (0x107C66C000)", bg=self.BG_CARD_ALT, fg=self.ACCENT_CYAN,
            bd=0, padx=10, pady=5, cursor="hand2",
            command=lambda: self._set_preset_addr(0x107C66C000)
        ).pack(side="left", padx=4)

        live_card = tk.Frame(parent, bg=self.BG_CARD, padx=16, pady=14, highlightthickness=1, highlightbackground=self.BORDER_COLOR)
        live_card.pack(fill="both", expand=True, pady=6)
        tk.Label(live_card, text="📊  Inspector de Variables de Link en Tiempo Real", bg=self.BG_CARD, fg=self.ACCENT_CYAN, font=("Segoe UI", 10, "bold")).pack(anchor="w", pady=(0, 6))
        self.lbl_inspector = tk.Label(
            live_card, text="Conecta el juego y carga tu partida para inspeccionar los bytes en tiempo real...",
            bg=self.BG_MAIN, fg=self.TEXT_PRIMARY, font=("Consolas", 10), justify="left", anchor="nw", padx=12, pady=10
        )
        self.lbl_inspector.pack(fill="both", expand=True)

    # -------------------------------------------------------------------------
    # PÁGINA 4: INVENTARIO, EDAD Y EXTRAS
    # -------------------------------------------------------------------------
    def _build_page_extras(self, parent):
        card = tk.Frame(parent, bg=self.BG_CARD, padx=16, pady=14, highlightthickness=1, highlightbackground=self.BORDER_COLOR)
        card.pack(fill="x", pady=(0, 10))

        tk.Label(card, text="🎒  Acciones Rápidas y Modificaciones Especiales", bg=self.BG_CARD, fg=self.ACCENT_GOLD, font=("Segoe UI", 12, "bold")).pack(anchor="w", pady=(0, 10))

        actions = [
            ("🗡️  Desbloquear Todo el Inventario (85 Objetos, Espadas, Túnicas, Botas y Medallones)", self.ACCENT_GREEN, "#052e16", self._action_unlock_all),
            ("⏳  Alternar Edad de Link en Vivo (Niño ↔ Adulto sin ir al Templo del Tiempo)", self.ACCENT_GOLD, "#1e1b4b", self._action_switch_age),
            ("💖  Inyectar 20 Corazones + 9999 Rupias + 99 Munición (Instantáneo)", "#2563eb", "#ffffff", self._action_instant_max),
            ("👻  Activar / Desactivar Vuelo Libre (No-Clip Flight de Hookshot Debug)", "#9333ea", "#ffffff", self._action_toggle_noclip),
        ]
        for text, bg_c, fg_c, cmd in actions:
            tk.Button(
                card, text=text, bg=bg_c, fg=fg_c, font=("Segoe UI", 10, "bold"),
                bd=0, pady=10, cursor="hand2", command=cmd
            ).pack(fill="x", pady=5)

    # -------------------------------------------------------------------------
    # PÁGINA 5: CONSOLA DE LOGS EN TIEMPO REAL
    # -------------------------------------------------------------------------
    def _build_page_logs(self, parent):
        top = tk.Frame(parent, bg=self.BG_CARD, padx=12, pady=8, highlightthickness=1, highlightbackground=self.BORDER_COLOR)
        top.pack(fill="x", pady=(0, 6))

        tk.Label(top, text="📟  Registro de Diagnóstico en Vivo (hookshot_modmenu_debug.log)", bg=self.BG_CARD, fg=self.ACCENT_GOLD, font=("Segoe UI", 10, "bold")).pack(side="left")

        tk.Button(
            top, text="Limpiar Consola", bg=self.BG_CARD_ALT, fg=self.TEXT_PRIMARY,
            bd=0, padx=10, pady=4, cursor="hand2", command=self._clear_logs
        ).pack(side="right", padx=4)

        tk.Button(
            top, text="Probar Conexión y Volcar Diagnóstico", bg=self.ACCENT_CYAN, fg="#083344",
            font=("Segoe UI", 9, "bold"), bd=0, padx=12, pady=4, cursor="hand2",
            command=self._action_run_diagnostics
        ).pack(side="right", padx=4)

        self.txt_logs = tk.Text(
            parent, bg="#070a0f", fg="#e2e8f0", insertbackground="#ffffff",
            font=("Consolas", 9), relief="flat", padx=10, pady=10, state="disabled"
        )
        self.txt_logs.pack(fill="both", expand=True)
        self.txt_logs.tag_config("INFO", foreground="#93c5fd")
        self.txt_logs.tag_config("OK", foreground="#34d399")
        self.txt_logs.tag_config("WARN", foreground="#fbbf24")
        self.txt_logs.tag_config("ERROR", foreground="#f87171")

    def _on_new_log_line(self, level, line):
        def _append():
            self.txt_logs.configure(state="normal")
            self.txt_logs.insert("end", line + "\n", level)
            self.txt_logs.see("end")
            self.txt_logs.configure(state="disabled")
        try:
            self.root.after(0, _append)
        except Exception:
            pass

    def _clear_logs(self):
        self.txt_logs.configure(state="normal")
        self.txt_logs.delete("1.0", "end")
        self.txt_logs.configure(state="disabled")

    # -------------------------------------------------------------------------
    # ACCIONES Y EVENTOS
    # -------------------------------------------------------------------------
    def _sync_cheats(self):
        self.ctrl.inf_health = self.var_inf_health.get()
        self.ctrl.inf_magic = self.var_inf_magic.get()
        self.ctrl.god_mode = self.var_god_mode.get()
        self.ctrl.moon_jump = self.var_moon_jump.get()
        self.ctrl.inf_rupees_ammo = self.var_inf_rupees.get()

        active = []
        if self.ctrl.inf_health: active.append("Vida Infinita")
        if self.ctrl.inf_magic: active.append("Magia Infinita")
        if self.ctrl.god_mode: active.append("Modo Dios")
        if self.ctrl.moon_jump: active.append("Salto Lunar / Vuelo")
        if self.ctrl.inf_rupees_ammo: active.append("Rupias/Munición Inf.")
        self.logger.info(f"Módulos activos actualizados: {', '.join(active) if active else 'Ninguno'}")

        if self.ctrl.god_mode:
            self.ctrl.set_option_via_bridge("heart_protection", 1)
        if self.ctrl.moon_jump:
            self.ctrl.set_option_via_bridge("no_clip_flight", 1)

    def _set_damage_multiplier(self, mult, log_change=True):
        self.var_dmg_mult.set(mult)
        self.ctrl.damage_mult = mult
        for m, btn in self.dmg_buttons.items():
            if m == mult:
                btn.configure(bg=self.ACCENT_GOLD, fg="#1e1b4b")
            else:
                btn.configure(bg=self.BG_CARD_ALT, fg=self.TEXT_PRIMARY)
        if log_change:
            self.logger.ok(f"Multiplicador de daño fijado en x{int(mult)}")
            self.ctrl.set_option_via_bridge("damage_multiplier", int(mult))

    def _action_browse_dir(self):
        chosen = filedialog.askdirectory(title="Selecciona la carpeta de instalación de Hookshot")
        if chosen:
            self.var_game_dir.set(chosen)
            self.ctrl.bridge.set_game_dir(chosen)
            self.logger.info(f"Carpeta de Hookshot seleccionada: {chosen}")

    def _action_configure_env(self):
        self.ctrl.bridge.set_game_dir(self.var_game_dir.get().strip())
        ok, msg = self.ctrl.bridge.configure_game_environment()
        if ok:
            messagebox.showinfo("Configuración Aplicada", msg)
        else:
            messagebox.showwarning("Aviso", msg)

    def _action_launch_game(self):
        ok, msg = self.ctrl.launch_game_with_bridge(self.var_game_dir.get().strip())
        if not ok:
            self._switch_page("logs")
            messagebox.showwarning("No se pudo iniciar", msg)

    def _action_relaunch_admin(self):
        if not sys.platform.startswith("win"):
            return
        try:
            script_path = os.path.abspath(__file__)
            ctypes.windll.shell32.ShellExecuteW(
                None, "runas", sys.executable, f'"{script_path}" --elevated', None, 1
            )
            self.root.destroy()
        except Exception as e:
            self.logger.err(f"No se pudo elevar a Administrador: {e}")

    def _action_auto_scan(self):
        self._switch_page("scanner")
        threading.Thread(target=self._run_scan_thread, args=(None, None, None), daemon=True).start()

    def _action_filtered_scan(self):
        rup_s = self.var_scan_rupees.get().strip()
        hrt_s = self.var_scan_hearts.get().strip()
        arr_s = self.var_scan_arrows.get().strip()
        rup = int(rup_s) if rup_s.isdigit() else None
        hrt = int(hrt_s) if hrt_s.isdigit() else None
        arr = int(arr_s) if arr_s.isdigit() else None
        threading.Thread(target=self._run_scan_thread, args=(rup, hrt, arr), daemon=True).start()

    def _run_scan_thread(self, rup, hrt, arr):
        found = self.ctrl.mem.scan_player_struct(known_rupees=rup, known_hearts=hrt, known_arrows=arr)
        if found:
            self.var_custom_addr.set(f"0x{self.ctrl.mem.player_struct_addr:X}")

    def _action_set_manual_addr(self):
        raw = self.var_custom_addr.get().strip()
        try:
            addr = int(raw, 16) if raw.lower().startswith("0x") else int(raw)
            self.ctrl.mem.player_struct_addr = addr
            self.ctrl.mem.struct_verified = self.ctrl.mem._is_valid_player_struct(addr)
            self.logger.ok(f"Dirección base fijada manualmente en 0x{addr:X} (Verificada={self.ctrl.mem.struct_verified})")
        except Exception:
            messagebox.showwarning("Formato inválido", "Introduce una dirección hexadecimal válida (ej. 0x107F37C000).")

    def _set_preset_addr(self, addr):
        self.ctrl.mem.player_struct_addr = addr
        self.ctrl.mem.struct_verified = self.ctrl.mem._is_valid_player_struct(addr)
        self.var_custom_addr.set(f"0x{addr:X}")
        self.logger.info(f"Cambiado al perfil de memoria 0x{addr:X} (Verificada={self.ctrl.mem.struct_verified})")

    def _action_teleport(self):
        sel = self.tree_tp.selection()
        if not sel:
            messagebox.showinfo("Selecciona un destino", "Haz clic en cualquier lugar de la tabla para teletransportarte.")
            return
        idx = int(sel[0])
        dest = next((d for d in TELEPORT_DESTINATIONS if d["idx"] == idx), None)
        if not dest:
            return
        self.ctrl.bridge.set_game_dir(self.var_game_dir.get().strip())
        ok, msg = self.ctrl.bridge.teleport(dest, age_mode=self.var_age_select.get())
        self.logger.ok(msg)

    def _action_unlock_all(self):
        self.ctrl.bridge.set_game_dir(self.var_game_dir.get().strip())
        self.ctrl.unlock_all_items_live()

    def _action_switch_age(self):
        cur = self.var_age_select.get()
        nxt = "adult" if cur != "adult" else "child"
        self.var_age_select.set(nxt)
        self.ctrl.bridge.set_game_dir(self.var_game_dir.get().strip())
        self.ctrl.bridge.send_bridge_command({"cmd": "age", "age": nxt})
        self.ctrl.bridge.append_live_command(f"!age {nxt}")
        self.logger.ok(f"Orden de cambio de edad enviada: Link {nxt.upper()}")

    def _action_instant_max(self):
        if self.ctrl.mem.attach():
            if not self.ctrl.mem.struct_verified:
                self.ctrl.mem.scan_player_struct()
            for f in ("max_health_1", "max_health_2", "max_health_3", "cur_health_1", "cur_health_2", "cur_health_3"):
                self.ctrl.mem.write_u32(self.ctrl.mem.get_field_addr(f), 0x50, log_write=True)
            self.ctrl.mem.write_u32(self.ctrl.mem.get_field_addr("rupees"), 9999, log_write=True)
            self.ctrl.mem.write_u32(self.ctrl.mem.get_field_addr("arrows"), 99)
            self.ctrl.mem.write_u32(self.ctrl.mem.get_field_addr("bombs"), 99)
        else:
            self.logger.warn("Juego no conectado en memoria. Enviando por HOS_INPUT_LIVE.")
            self.ctrl.bridge.append_live_command("!cheat refill")

    def _action_toggle_noclip(self):
        self.ctrl.no_clip = not self.ctrl.no_clip
        val = 1 if self.ctrl.no_clip else 0
        self.ctrl.set_option_via_bridge("no_clip_flight", val)
        self.ctrl.bridge.append_live_command(f"!cheat flight_{val}")
        self.logger.ok(f"Vuelo No-Clip {'ACTIVADO' if val else 'DESACTIVADO'}")

    def _action_run_diagnostics(self):
        self.logger.info("=== INICIANDO DIAGNÓSTICO COMPLETO DE HOOKSHOT v3.0 ===")
        procs = self.ctrl.mem.list_candidate_processes()
        if not procs:
            self.logger.warn("No se detectó ningún proceso hookshot.exe en ejecución.")
            return
        for p in procs:
            self.logger.info(
                f"Candidato PID {p['pid']}: {p['path']} | "
                f"RAM Comprometida: {p['committed_mb']} MB | Virtual Reservada: {p['reserved_gb']:.1f} GB"
            )
        if self.ctrl.mem.attach():
            regs = self.ctrl.mem.enumerate_committed_rw_regions(include_all_address_space=True)
            total_mb = sum(s for _, s in regs) / (1024 * 1024)
            self.logger.ok(f"Regiones RW comprometidas totales: {len(regs)} bloques ({total_mb:.1f} MB)")
            base = self.ctrl.mem.player_struct_addr
            vals = {k: self.ctrl.mem.read_u32(base + off) for k, off in STRUCT_OFFSETS.items()}
            self.logger.info(f"Lectura en base actual 0x{base:X}: {vals}")

    def _bind_hotkeys(self):
        self.root.bind("<F5>", lambda _e: self._hotkey_flip(self.var_inf_health))
        self.root.bind("<F6>", lambda _e: self._hotkey_flip(self.var_inf_magic))
        self.root.bind("<F7>", lambda _e: self._hotkey_flip(self.var_god_mode))
        self.root.bind("<F8>", lambda _e: self._hotkey_flip(self.var_moon_jump))
        self.root.bind("<F9>", lambda _e: self._hotkey_flip(self.var_inf_rupees))

    def _hotkey_flip(self, var):
        var.set(not var.get())
        self._sync_cheats()

    def _ui_refresh_loop(self):
        if self.ctrl.mem.is_attached():
            if self.ctrl.mem.struct_verified:
                self.var_tele_pid.set(f"CONECTADO (PID {self.ctrl.mem.pid})")
                self.badge_pid.configure(fg=self.ACCENT_GREEN)
                chp = self.ctrl.live_cur_hp / 4.0
                mhp = self.ctrl.live_max_hp / 4.0
                self.var_tele_hp.set(f"{chp:.1f} / {mhp:.0f} ♥")
                self.var_tele_magic.set(f"{self.ctrl.live_magic} / 96")
                self.var_tele_rupees.set(f"{self.ctrl.live_rupees}")
                self.var_tele_cycles.set(f"{self.ctrl.write_cycles}")
                status_str = f"VERIFICADA (Slot #{self.ctrl.mem.active_health_slot})"
            else:
                self.var_tele_pid.set(f"EN MENÚ / CARGANDO (PID {self.ctrl.mem.pid})")
                self.badge_pid.configure(fg=self.ACCENT_GOLD)
                self.var_tele_hp.set("ESPERANDO PARTIDA")
                self.var_tele_magic.set("--")
                self.var_tele_rupees.set("--")
                chp = 0.0
                mhp = 0.0
                status_str = "ESPERANDO QUE ENTRES A LA PARTIDA ('Continuar') O USES EL ESCÁNER"

            base = self.ctrl.mem.player_struct_addr
            self.var_custom_addr.set(f"0x{base:X}")
            inspector_txt = (
                f"Proceso Adjunto        : {self.ctrl.mem.process_name} (PID: {self.ctrl.mem.pid})\n"
                f"Ruta del Ejecutable    : {self.ctrl.mem.exe_full_path or 'bin/hookshot.exe'}\n"
                f"Base Estructura Link   : 0x{base:012X}  ({status_str})\n"
                f"Corazones (Actual/Máx) : {self.ctrl.live_cur_hp} / {self.ctrl.live_max_hp}  ({chp:.2f} / {mhp:.0f} corazones)\n"
                f"Magia Actual           : {self.ctrl.live_magic}  (0x{self.ctrl.live_magic:02X})\n"
                f"Rupias (+0x134)        : {self.ctrl.live_rupees}\n"
                f"Flechas (+0x814)       : {self.ctrl.live_arrows}   |   Bombas (+0x83C) : {self.ctrl.live_bombs}\n"
                f"Puente HOS_INPUT_LIVE  : {self.ctrl.bridge.live_file_path}\n"
                f"Socket HOS_CONTROL     : {self.ctrl.bridge.socket_path}"
            )
            self.lbl_inspector.configure(text=inspector_txt)
        else:
            self.var_tele_pid.set("ESPERANDO JUEGO...")
            self.badge_pid.configure(fg=self.ACCENT_GOLD)
            self.var_tele_hp.set("-- / --")
            self.var_tele_magic.set("--")
            self.var_tele_rupees.set("--")

        self.root.after(400, self._ui_refresh_loop)


def ensure_windows_admin():
    """
    Si el usuario abre el script con doble clic en Windows sin permisos de
    Administrador, solicita elevación UAC automáticamente una sola vez.
    """
    if not sys.platform.startswith("win"):
        return
    if "--elevated" in sys.argv or "--no-elevate" in sys.argv:
        return
    try:
        if not ctypes.windll.shell32.IsUserAnAdmin():
            script_path = os.path.abspath(__file__)
            res = ctypes.windll.shell32.ShellExecuteW(
                None, "runas", sys.executable, f'"{script_path}" --elevated', None, 1
            )
            if int(res) > 32:
                sys.exit(0)
    except Exception:
        pass


def main():
    ensure_windows_admin()
    root = tk.Tk()
    app = HookshotModernGUI(root)
    root.mainloop()


if __name__ == "__main__":
    main()